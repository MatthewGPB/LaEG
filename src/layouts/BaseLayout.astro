---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import WeeklySpecialPopup from '../components/WeeklySpecialPopup.astro';
import FloatingOrderButton from '../components/FloatingOrderButton.astro';
import ClickTracking from '../components/ClickTracking.astro';
interface Props {
  title: string; description: string; path: string; image?: string;
  schema?: object | object[]; showPopup?: boolean; noindex?: boolean; lang?: 'en' | 'es';
  alternates?: { hreflang: string; href: string }[];
}
const { title, description, path, image, schema, showPopup = false, noindex = false, lang = 'en', alternates = [] } = Astro.props;
const skipLabel = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/LAEG/favicon.png" />
    <link rel="apple-touch-icon" href="/LAEG/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} path={path} image={image} schema={schema} noindex={noindex} lang={lang} alternates={alternates} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-navy focus:px-4 focus:py-2 focus:text-cream">{skipLabel}</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <FloatingOrderButton lang={lang} />
    {showPopup && <WeeklySpecialPopup lang={lang} />}
    <script>
      (function () {
        const forms = document.querySelectorAll('form.form-wrap');
        forms.forEach((form) => {
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const button = form.querySelector('button[type="submit"]');
            const label = button?.querySelector('.btn-label');
            const successEl = form.querySelector('.form-success');
            const errorEl = form.querySelector('.form-error');
            const originalLabel = label?.textContent || 'Send';
            const sendingLabel = form.dataset.sendingLabel || 'Sending…';
            const honeypot = form.querySelector('input[name="_gotcha"]');
            if (honeypot && honeypot.value) return;
            if (button) button.disabled = true;
            if (label) label.textContent = sendingLabel;
            const fd = new FormData(form);
            fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } })
              .then((res) => {
                if (res.ok) {
                  form.querySelectorAll(':scope > *:not(.form-success):not(.form-error)').forEach((el) => {
                    if (!el.classList.contains('form-success') && !el.classList.contains('form-error')) { el.style.display = 'none'; }
                  });
                  successEl?.classList.remove('hidden');
                  if (typeof window.gtag === 'function') { window.gtag('event', 'form_submit', { form_name: form.dataset.formName || 'unknown' }); }
                  successEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else { throw new Error('Form submission failed'); }
              })
              .catch(() => { errorEl?.classList.remove('hidden'); if (button) button.disabled = false; if (label) label.textContent = originalLabel; });
          });
        });
      })();
    </script>
    <ClickTracking />
  </body>
</html>
