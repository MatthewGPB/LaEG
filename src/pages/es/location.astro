---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
import { hoursTable, SHORT } from '../../data/hours';
import pending from '../../data/pending.json';
import Confirm from '../../components/Confirm.astro';
import { restaurantSchema } from '../../lib/schema';
const description = "Encuentra La Esquina Guatemalteca en 200 Hibiscus St, Jupiter, FL 33458. Horario, direcciones y estacionamiento. Abierto de martes a domingo, cerrado los lunes. Llama al 561-768-9137.";
const alternates = [ { hreflang: 'en', href: site.domain + '/location' }, { hreflang: 'es', href: site.domain + '/es/location' }, { hreflang: 'x-default', href: site.domain + '/location' } ];
const schema = restaurantSchema({ lang: 'es', url: site.domain + '/es/location' });
const table = hoursTable('es');
---
<BaseLayout title="Ubicación y Horario — 200 Hibiscus St, Jupiter FL" description={description} path="/es/location" schema={schema} lang="es" alternates={alternates}>
  <section class="container-x pt-14 pb-10 text-center lg:pt-20"><p class="eyebrow">Visítanos</p><h1 class="mt-3 text-balance font-display text-5xl font-bold text-navy md:text-6xl">Tu esquina guatemalteca en Jupiter</h1><p class="mx-auto mt-5 max-w-2xl font-body text-lg text-ink/75">Justo en Hibiscus Street — estacionamiento fácil, bienvenida cálida y tortillas hechas a mano esperándote.</p></section>
  <section class="container-x grid gap-10 pb-20 lg:grid-cols-5 lg:gap-14">
    <div class="self-start overflow-hidden rounded-3xl shadow-card lg:col-span-3"><iframe src={site.mapEmbed} width="100%" height="480" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa a La Esquina Guatemalteca, 200 Hibiscus St, Jupiter FL" class="h-[480px] w-full"></iframe></div>
    <div class="flex flex-col gap-6 lg:col-span-2">
      <div class="rounded-3xl bg-white p-8 shadow-card"><h2 class="font-display text-2xl font-bold text-navy">Dirección</h2><address class="mt-3 not-italic font-body text-lg leading-relaxed text-ink/80">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}</address><a href={site.directionsUrl} target="_blank" rel="noopener" class="btn-primary mt-5 w-full justify-center">Cómo llegar</a></div>
      <div class="rounded-3xl bg-white p-8 shadow-card"><h2 class="font-display text-2xl font-bold text-navy">Horario</h2><p class="mt-2 font-body text-sm font-semibold text-spice">{SHORT.es}</p><table class="mt-4 w-full font-body text-base"><caption class="sr-only">Horario de atención</caption><tbody>{table.map((r) => (<tr class="border-b border-navy-100 last:border-0"><th scope="row" class="py-2.5 pr-4 text-left font-semibold text-navy">{r.day}</th><td class={`py-2.5 text-right ${r.closed ? 'font-semibold text-spice' : 'text-ink/80'}`}>{r.text}</td></tr>))}</tbody></table>{pending.holidayHours.confirmed && pending.holidayHours.dates.length > 0 ? (<div class="mt-5 border-t border-navy-100 pt-4"><h3 class="font-display text-lg font-bold text-navy">Horario festivo</h3><ul class="mt-2 space-y-1.5">{pending.holidayHours.dates.map((h: any) => (<li class="flex justify-between gap-4 font-body text-sm"><span class="font-semibold text-navy">{h.labelEs}</span><span class="text-ink/70">{h.hoursEs}</span></li>))}</ul></div>) : (<Confirm label="Se quitó el bloque de horario festivo. Agregar lista con fechas de Matthew o dejarlo fuera." />)}{!pending.bar.confirmed && <Confirm label="Mención de cerveza, vino y cócteles en /es/location, pendiente de confirmar." />}</div>
      <div class="rounded-3xl bg-navy p-8 text-cream shadow-card"><h2 class="font-display text-2xl font-bold text-marigold">Llámanos</h2><p class="mt-2 font-body text-cream/80">Preguntas, órdenes por adelantado o aviso de grupos grandes:</p><a href={`tel:${site.phoneTel}`} class="mt-3 block font-display text-3xl font-bold hover:text-marigold">{site.phone}</a></div>
    </div>
  </section>
  <section class="container-x pb-20 text-center"><div class="rounded-3xl bg-gradient-to-br from-navy via-navy-600 to-navy px-6 py-14 text-cream shadow-deep"><h2 class="text-balance font-display text-3xl font-bold md:text-4xl">Evita la espera — ordena por adelantado.</h2><a href={site.orderUrl} target="_blank" rel="noopener" class="btn-spice mt-7">Ordenar para llevar en línea</a></div></section>
</BaseLayout>
