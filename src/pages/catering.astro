---
import BaseLayout from '../layouts/BaseLayout.astro';
import CateringForm from '../components/CateringForm.astro';
import SmartImage from '../components/SmartImage.astro';
import site from '../data/site.json';

const description = "Guatemalan catering in Palm Beach County. Trusted by Frenchman's Reserve, Jupiter Hills Club, Avenir, Mirasol & Breakers West. Custom menus for weddings, corporate & private events. Request a quote.";

const alternates = [
  { hreflang: 'en', href: site.domain + '/catering' },
  { hreflang: 'es', href: site.domain + '/es/catering' },
  { hreflang: 'x-default', href: site.domain + '/catering' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: `${site.name} Catering`,
  servesCuisine: 'Guatemalan',
  url: site.domain + '/catering',
  telephone: site.phoneTel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: site.areaServed.map((a) => ({ '@type': 'City', name: a })),
};
---

<BaseLayout
  title="Catering — Weddings, Corporate & Private Events"
  description={description}
  path="/catering"
  image="/LAEG/food-truck.jpeg"
  schema={schema}
  alternates={alternates}
>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <SmartImage
        src="/LAEG/food-truck.jpeg"
        alt="Guatamigos food truck catering a Palm Beach County event"
        class="h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-navy/70 via-navy/50 to-navy/90"></div>
    </div>
    <div class="container-x relative py-28 text-center text-cream lg:py-36">
      <p class="eyebrow text-marigold">Catering by La Esquina</p>
      <h1 class="mx-auto mt-4 max-w-3xl text-balance font-display text-5xl font-bold leading-tight md:text-6xl">
        Flavors your guests will <span class="italic text-marigold">still be talking about.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-pretty font-body text-lg text-cream/85 md:text-xl">
        Authentic Guatemalan catering for weddings, corporate events, and private celebrations
        across Palm Beach County.
      </p>
      <a href="#quote" class="btn-spice mt-9">Request your custom quote</a>
    </div>
  </section>

  <!-- TRUSTED BY -->
  <section class="border-b border-navy-100 bg-white py-12">
    <div class="container-x text-center">
      <p class="eyebrow">Trusted by Palm Beach County's premier venues</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
        {site.trustedBy.map((venue) => (
          <SmartImage
            src={venue.logo}
            alt={venue.name}
            class="h-12 w-auto object-contain opacity-70 grayscale transition-all hover:opacity-100 hover:grayscale-0 lg:h-14"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="container-x py-20 lg:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Simple &amp; stress-free</p>
      <h2 class="mt-3 text-balance font-display text-4xl font-bold text-navy md:text-5xl">How it works</h2>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <div class="rounded-3xl bg-white p-8 shadow-card">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-marigold/20 font-display text-xl font-bold text-marigold-dark">1</div>
        <h3 class="mt-5 font-display text-xl font-bold text-navy">Tell us your vision</h3>
        <p class="mt-3 font-body text-ink/70">
          Share your date, guest count, and the vibe you're going for. Traditional Guatemalan feast?
          Taco bar? La Parrillada station? We'll shape it together.
        </p>
      </div>
      <div class="rounded-3xl bg-white p-8 shadow-card">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-marigold/20 font-display text-xl font-bold text-marigold-dark">2</div>
        <h3 class="mt-5 font-display text-xl font-bold text-navy">Get your custom menu</h3>
        <p class="mt-3 font-body text-ink/70">
          Within 24 hours, Silvia sends a proposed menu and clear pricing tailored to your event —
          with options for every dietary need.
        </p>
      </div>
      <div class="rounded-3xl bg-white p-8 shadow-card">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-marigold/20 font-display text-xl font-bold text-marigold-dark">3</div>
        <h3 class="mt-5 font-display text-xl font-bold text-navy">We handle the rest</h3>
        <p class="mt-3 font-body text-ink/70">
          Fresh preparation, on-time delivery or full service, beautiful presentation. You enjoy
          the party; we handle the food.
        </p>
      </div>
    </div>
  </section>

  <!-- QUOTE FORM -->
  <section id="quote" class="scroll-mt-24 bg-cream-200/50 py-20 lg:py-24">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Let's plan your event</p>
        <h2 class="mt-3 text-balance font-display text-4xl font-bold text-navy md:text-5xl">
          Request your custom quote
        </h2>
        <p class="mt-4 font-body text-lg text-ink/75">
          Tell us about your celebration and we'll reply within 24 hours — every day of the week.
        </p>
      </div>
      <div class="mt-12">
        <CateringForm lang="en" />
      </div>
    </div>
  </section>

  <!-- CTA STRIP -->
  <section class="container-x py-16 text-center">
    <p class="font-body text-lg text-ink/75">
      Prefer to talk it through?
      <a href={`tel:${site.phoneTel}`} class="font-semibold text-spice hover:underline">Call {site.phone}</a>
      — Silvia loves planning menus.
    </p>
  </section>
</BaseLayout>
