---
// Visible only on local/preview builds. Never renders in production.
import { SHOW_PENDING } from '../lib/env';
interface Props { label: string; class?: string; }
const { label, class: cls = '' } = Astro.props;
---
{SHOW_PENDING && (
  <div class={`confirm-placeholder mx-auto my-3 max-w-2xl rounded-xl border-2 border-dashed border-amber-500 bg-amber-50 px-4 py-3 text-left font-body text-sm text-amber-900 ${cls}`} data-confirm={label}>
    <strong class="font-bold">CONFIRM (preview only):</strong>{' '}{label}
  </div>
)}
