---
// Google social proof. Rating, count and excerpts come from src/data/reviews.json.
// Excerpts are verbatim from real Google reviewers. Production builds show only
// approved excerpts; preview builds show every excerpt with a "Pending approval" tag.
// Intentionally NO AggregateRating / Review schema (self-serving review markup).
import reviews from '../data/reviews.json';
import { SHOW_PENDING } from '../lib/env';
interface Props { lang?: 'en' | 'es'; }
const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
const excerpts = reviews.excerpts.filter((r) => r.approved || SHOW_PENDING);
const T = isEs
  ? { eyebrow: 'Lo que dicen nuestros clientes', title: 'Reseñas en Google', count: `${reviews.count} reseñas en Google`, cta: 'Lee todas las reseñas en Google', stars: `${reviews.rating} de 5 estrellas`, note: 'Reseñas originales en inglés.', pending: 'Pendiente de aprobación' }
  : { eyebrow: 'What our guests say', title: 'Reviews on Google', count: `${reviews.count} Google reviews`, cta: 'Read all reviews on Google', stars: `${reviews.rating} out of 5 stars`, note: '', pending: 'Pending approval' };
const full = Math.floor(reviews.rating);
const frac = reviews.rating - full;
---
<section class="bg-white py-16 lg:py-20" aria-labelledby="reviews-title">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{T.eyebrow}</p>
      <h2 id="reviews-title" class="mt-3 text-balance font-display text-4xl font-bold text-navy md:text-5xl">{T.title}</h2>
      <div class="mt-6 flex flex-col items-center gap-2">
        <div class="flex items-center gap-3">
          <span class="font-display text-5xl font-bold text-navy">{reviews.rating}</span>
          <span class="flex" role="img" aria-label={T.stars}>
            {[0, 1, 2, 3, 4].map((i) => (
              <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
                <defs><linearGradient id={`star-${lang}-${i}`}><stop offset={i < full ? '100%' : i === full ? `${Math.round(frac * 100)}%` : '0%'} stop-color="#e8a52a" /><stop offset={i < full ? '100%' : i === full ? `${Math.round(frac * 100)}%` : '0%'} stop-color="#dbe7f3" /></linearGradient></defs>
                <path fill={`url(#star-${lang}-${i})`} d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" />
              </svg>
            ))}
          </span>
        </div>
        <p class="font-body text-base text-ink/70">{T.count}</p>
      </div>
    </div>
    {excerpts.length > 0 && (
      <ul class="mx-auto mt-10 grid max-w-5xl gap-5 sm:grid-cols-2">
        {excerpts.map((r: any) => (
          <li class="rounded-3xl bg-cream p-7 shadow-soft">
            {!r.approved && <span class="mb-3 inline-block rounded-full border border-dashed border-amber-500 bg-amber-50 px-2.5 py-0.5 font-body text-[11px] font-bold uppercase tracking-wide text-amber-900">{T.pending}</span>}
            <blockquote class="font-display text-lg italic leading-relaxed text-navy" lang="en">“{r.text}”</blockquote>
            <p class="mt-4 font-body text-sm font-semibold text-ink/70">{r.author}{r.authorNote ? <span class="font-normal text-ink/50"> · {r.authorNote}</span> : null}</p>
          </li>
        ))}
      </ul>
    )}
    {isEs && excerpts.length > 0 && <p class="mt-4 text-center font-body text-xs text-ink/50">{T.note}</p>}
    <div class="mt-10 text-center">
      <a href={reviews.googleUrl} target="_blank" rel="noopener" class="btn-primary">{T.cta}</a>
    </div>
  </div>
</section>
