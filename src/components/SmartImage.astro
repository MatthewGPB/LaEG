---
// Responsive image. Paths like "/LAEG/tacos.jpeg" (as stored in the data files) are resolved
// to the matching file in src/assets/LAEG and rendered with Astro's <Picture>, which emits
// AVIF + WebP sources at several widths with explicit width/height (no layout shift).
// Below-the-fold images lazy-load by default; pass loading="eager" + fetchpriority="high"
// for the hero. Unknown paths fall back to a plain <img> with a branded placeholder on error.
// The original files stay in /public/LAEG so existing image URLs (og:image, JSON-LD) keep working.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: number[];
}
const {
  src, alt, class: className = '', width, height, loading = 'lazy', fetchpriority = 'auto',
  sizes = '(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
  widths,
} = Astro.props;

const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/LAEG/*.{jpeg,jpg,png}', { eager: true });
const key = '/src/assets' + src;
const img = assets[key]?.default;
const candidateWidths = widths || [320, 480, 640, 960, 1280, 1600];
const useWidths = img ? [...new Set(candidateWidths.filter((w) => w < img.width).concat(Math.min(img.width, Math.max(...candidateWidths))))].sort((a, b) => a - b) : [];

const fallback =
  "data:image/svg+xml;utf8," +
  encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'>
      <defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='#1e3a5f'/><stop offset='1' stop-color='#3a6ea5'/></linearGradient></defs>
      <rect width='400' height='300' fill='url(#g)'/>
      <text x='50%' y='50%' fill='#fdf8f0' font-family='Georgia,serif' font-size='28' text-anchor='middle' opacity='0.95'>La Esquina</text>
      <text x='50%' y='62%' fill='#fdf8f0' font-family='Georgia,serif' font-size='16' text-anchor='middle' opacity='0.75'>Guatemalteca</text>
    </svg>`
  );
---
{img ? (
  <Picture
    src={img}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat={img.format === 'png' ? 'png' : 'jpg'}
    widths={useWidths}
    sizes={sizes}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={loading === 'eager' ? 'sync' : 'async'}
  />
) : (
  <img src={src} alt={alt} class={className} width={width || 400} height={height || 300} loading={loading} fetchpriority={fetchpriority} decoding="async" onerror={`this.onerror=null;this.src='${fallback}';`} />
)}
